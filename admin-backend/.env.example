# Copy to .env and adjust. Used by Docker Compose (admin-backend mounted at /var/www).

APP_NAME=theSmartr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# URL browsers use to reach nginx (e.g. http://localhost when using docker-compose webserver on port 80)
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=THESMARTR
DB_USERNAME=thsroot
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# sync = jobs run inside the web PHP process (OK for small bulk uploads).
# database = use `docker compose up -d queue` after migrating (includes `jobs` table) for large/queued imports.
QUEUE_CONNECTION=sync

# Large Excel imports enqueue a background job when true AND QUEUE_CONNECTION is not sync.
# PRODUCTS_BULK_USE_QUEUE=true

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Admin portal auth (OTP) ---
# false = random OTP; true = fixed code from ADMIN_FIXED_OTP (dev only).
ADMIN_USE_FIXED_OTP=true
ADMIN_FIXED_OTP=123456

# When true, login/forgot-PIN OTP is sent via Laravel Mail (configure MAIL_* or platform mail settings).
ADMIN_OTP_VIA_MAIL=false

# MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="${APP_NAME}"
